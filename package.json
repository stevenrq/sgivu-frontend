{
  "name": "sgivu-frontend",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "e2e": "playwright test",
    "lint": "ng lint",
    "docs": "compodoc",
    "docs:serve": "compodoc --serve",
    "prepare": "husky"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix --no-warn-ignored"
    ],
    "*.{ts,html,css,js,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@angular/common": "^21.0.5",
    "@angular/compiler": "^21.0.5",
    "@angular/core": "^21.0.5",
    "@angular/forms": "^21.0.5",
    "@angular/platform-browser": "^21.0.5",
    "@angular/platform-browser-dynamic": "^21.0.5",
    "@angular/router": "^21.0.5",
    "@fontsource/manrope": "^5.2.8",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "ng2-charts": "^8.0.0",
    "rxjs": "~7.8.2",
    "sweetalert2": "^11.26.10",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.5",
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@compodoc/compodoc": "^1.2.1",
    "@playwright/test": "^1.60.0",
    "@types/bootstrap": "^5.2.10",
    "@vitest/coverage-v8": "^4.1.8",
    "angular-eslint": "^21.0.1",
    "baseline-browser-mapping": "^2.9.7",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "prettier": "3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.49.0",
    "vitest": "^4.1.8"
  }
}
